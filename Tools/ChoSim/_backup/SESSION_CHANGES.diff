+    // Called by GameController whenever AI control changes, so the button reflects state.
+    public void SetAiButtonState(bool whiteAi, bool blackAi)
+    {
+        if (aiButtonObject == null) return;
+
+        Color bg;
+        string label;
+
+        if (whiteAi && blackAi)      { bg = aiButtonBothColor;  label = "AI\nBOTH"; }
+        else if (blackAi)            { bg = aiButtonBlackColor; label = "AI\nBLACK"; }
+        else if (whiteAi)            { bg = aiButtonWhiteColor; label = "AI\nWHITE"; }
+        else                         { bg = aiButtonOffColor;   label = "AI\nOFF"; }
+
+        var sr = aiButtonObject.GetComponent<SpriteRenderer>();
+        if (sr != null) sr.color = bg;
+
+        if (aiButtonLabel != null)
+        {
+            aiButtonLabel.text = label;
+
+            // Pick whichever of black/white text stays readable on this background.
+            float luminance = 0.299f * bg.r + 0.587f * bg.g + 0.114f * bg.b;
+            aiButtonLabel.color = luminance > 0.5f ? Color.black : Color.white;
+        }
+    }
