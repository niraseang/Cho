+            var labelObj = new GameObject("AiToggleLabel");
+            labelObj.transform.SetParent(transform, false);
+            aiButtonLabel = labelObj.AddComponent<TextMesh>();
+        }
+
+        // TextMesh renders blank unless its MeshRenderer uses the font's own material.
+        var font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
+        if (font == null)
+        {
+            Destroy(aiButtonLabel.gameObject);
+            aiButtonLabel = null;
+            return;
         }
+
+        aiButtonLabel.font = font;
+        var mr = aiButtonLabel.GetComponent<MeshRenderer>();
+        if (mr != null)
+        {
+            mr.sharedMaterial = font.material;
+            mr.sortingOrder = 101; // just above the button face
+        }
+
+        aiButtonLabel.anchor = TextAnchor.MiddleCenter;
+        aiButtonLabel.alignment = TextAlignment.Center;
+        aiButtonLabel.fontSize = 48;
+        aiButtonLabel.characterSize = aiButtonLabelScale * squareSize;
+
+        aiButtonLabel.transform.position = new Vector3(buttonPos.x, buttonPos.y, buttonPos.z - 0.1f);
+    }
